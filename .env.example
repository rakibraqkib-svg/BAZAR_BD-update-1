# Optional Supabase configuration. Copy this file to .env.local and fill in your values.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Optional: Gemini key is only safe here if it is consumed by a server-side function.
